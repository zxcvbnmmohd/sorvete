  "compounds": [
    {
      "name": "All Apps \u2014 Web",
      "configurations": [
        "admin (web :5001)",
        "customer (web :5002)",
        "driver (web :5003)",
        "merchant (web :5004)",
        "pos (web :5005)",
        "kds (web :5006)"
      ],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "app",
      "type": "pickString",
      "description": "App",
      "options": [
        "admin",
        "customer",
        "driver",
        "merchant",
        "pos",
        "kds"
      ],
      "default": "customer"
    },
    {
      "id": "flavor",
      "type": "pickString",
      "description": "Flavor",
      "options": [
        "dev",
        "prod"
      ],
      "default": "dev"
    },
    {
      "id": "mode",
      "type": "pickString",
      "description": "Build mode",
      "options": [
        "debug",
        "profile",
        "release"
      ],
      "default": "debug"
    },
    {
      "id": "service",
      "type": "pickString",
      "description": "Service",
      "options": [
        "ads",
        "analytics",
        "audit",
        "catalog",
        "config",
        "device",
        "disputes",
        "fulfillment",
        "geo",
        "gift_cards",
        "identity",
        "inventory",
        "kitchen",
        "kyc",
        "loyalty",
        "marketing",
        "media",
        "merchant",
        "notifications",
        "ordering",
        "payments",
        "payouts",
        "pricing",
        "promotions",
        "recommendations",
        "reservations",
        "reviews",
        "risk",
        "search",
        "support",
        "wallet",
        "webhooks"
      ],
      "default": "identity"
    }
