  "configurations": [
    {
      "name": "app (native)",
      "cwd": "apps/${input:app}",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--${input:mode}",
        "--dart-define=FLAVOR=${input:flavor}"
      ]
    },
    {
      "name": "admin (web :5001)",
      "cwd": "apps/admin",
      "program": "lib/main.dart",
