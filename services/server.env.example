# Per-service local dev secrets for `docker compose` (serve_service.sh).
# Copy this into each service's server dir as `.env` (gitignored):
#   cp services/server.env.example services/<svc>/server/.env
# then fill in fresh values. `docker compose` auto-loads `.env` from the dir
# it runs in. These passwords only protect throwaway local containers.
#
#   SERVICE_DB_PASSWORD          must match config/passwords.yaml `development.database`
#   SERVERPOD_PASSWORD_database  must match config/passwords.yaml `test.database`
SERVICE_DB_PASSWORD=change-me-dev
SERVERPOD_PASSWORD_database=change-me-test
